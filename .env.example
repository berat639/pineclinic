# ── Gemini API key ──
# https://aistudio.google.com/apikey adresinden oluştur
GEMINI_API_KEY=your-gemini-api-key

# Embedding modeli (Gemini API)
# Varsayılan: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# DB vector(768) ile uyum için varsayılan 768
GEMINI_EMBEDDING_DIMENSIONS=768

# Gemini Live model
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: model used by the web written assistant. Defaults to gemini-2.5-flash.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Voices: Aoede (female), Kore (female), Charon (male), Puck (male), Fenrir (male)
GEMINI_LIVE_VOICE=Aoede

# Server port
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://voiceai:voiceai_secret@localhost:5432/voiceai

# Redis
REDIS_URL=redis://localhost:6379

# CORS origin for the server (default: http://localhost:3000)
# ngrok ile dışarıdan açılırken Next URL’ini de ekleyin (virgülle birden fazla):
# CORS_ORIGIN=http://localhost:3000,https://xxxx.ngrok-free.app
CORS_ORIGIN=http://localhost:3000

# Client env (add to client/.env.local)
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
# Yerel: NEXT_PUBLIC_BACKEND_URL gerekmez (next.config varsayılan localhost:3001).
# ngrok: `bun run ngrok` sonrası inspect (4040) üzerinden URL’leri alın:
# NEXT_PUBLIC_BACKEND_URL=https://xxxx.ngrok-free.app
# NEXT_PUBLIC_WS_URL=wss://xxxx.ngrok-free.app/ws

# Google Calendar integration (optional — skip if not configured)
# Service account must have Calendar API access and be shared on the calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google OAuth (Calendar yapılandırması admin panelden bağlanır)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth callback URL — Google Cloud Console > OAuth Client > Authorized redirect URIs
# içinde KAYITLI olan tek URL. Production veya ngrok static domain önerilir.
# Ngrok ücretsiz static domain: https://dashboard.ngrok.com/domains (her hesaba 1 adet)
# Boş bırakılırsa APP_URL + /api/admin/settings/calendar/callback fallback'i kullanılır.
OAUTH_REDIRECT_URI=https://your-static.ngrok-free.app/api/admin/settings/calendar/callback

# Backend base URL (sunucu kendi mutlak URL'lerini üretirken kullanır)
APP_URL=http://localhost:3001
# Frontend base URL (OAuth dönüşünde fallback redirect için)
CLIENT_APP_URL=http://localhost:3000

# İlk migration sırasında mevcut verilerin bağlanacağı kliniğin adı ve domainleri.
# Dokploy'da uygulamaya yönlendirdiğiniz hostları virgülle ayırın. Sonradan eklenen
# yeni bir host, platform yöneticisinin o hosttan ilk başarılı girişinde otomatik
# olarak ayrı bir klinik şeklinde oluşturulur.
DEFAULT_CLINIC_NAME=Varsayılan Klinik
DEFAULT_CLINIC_HOSTS=mrys.ornekklinik.com

# ── Evolution API / WhatsApp ────────────────────────────────────────────────
# Klinik bağlantı sırlarını AES-256-GCM ile şifreler. Bir kez üretin; sonradan
# değiştirmek kayıtlı entegrasyon anahtarlarını okunamaz hale getirir.
# Üretim: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=
# Tüm kliniklerin kullandığı merkezi Evolution servisi. Dokploy'da bu depodaki
# deploy/dokploy/evolution.compose.yml ile iç ağda çalışıyorsa aşağıdaki adresi
# kullanın; API anahtarı yalnız sunucuda tutulur.
EVOLUTION_API_URL=http://voiceai-evolution:8080
EVOLUTION_API_KEY=
# Evolution aynı Dokploy ağındaysa webhook'u doğrudan backend'e iletir. Ayrı bir
# sunucu kullanılıyorsa bu alan HTTPS ile erişilebilen backend adresi olmalıdır.
EVOLUTION_WEBHOOK_BASE_URL=http://voiceai-server:3001

# Admin panel password (/admin sayfasına erişim için)
ADMIN_PASSWORD=your-admin-password

# ── Telephony (Netgsm SIP Trunk → Gemini Live) ───────────────────────────────
# 1 yap: server + asterisk container'larında telephony köprüsünü aç.
# Lokalde 0 bırakın; testler sunucuda git push sonrası yapılır.
# Asterisk /api/telephony/register çağrısını ilgili kliniğin domaini üzerinden
# yapmalıdır; çağrı böylece aynı klinik bağlamındaki AI, RAG ve ayarları kullanır.
TELEPHONY_ENABLED=0
AUDIOSOCKET_PORT=12000
# Numara -> klinik domaini eşleştirmesi. Birden fazla kayıt virgülle ayrılır.
# Örnek: 8503096119=pineclinic.thinpine.com,85031234567=guneyagizvedissagligi.com
TELEPHONY_DID_MAP=8503096119=pineclinic.thinpine.com

# ── Telefon noise gate (server-side) ─────────────────────────────────────────
# Asterisk → Gemini akışında arka plan gürültüsünü (TV, müzik, ikinci konuşma)
# filtreler. RMS (Int16 ölçeği) eşik altındaki frame'ler Gemini'ye sessizlik
# olarak gönderilir → Gemini VAD'i yanlış tetiklenmez.
#
# DEPLOYMENT REHBERİ
#   Aşama 1 — Telemetri (zero risk): PHONE_NOISE_GATE_RMS=0 ile başlayın.
#     Davranış mevcut prod ile birebir aynı kalır; sadece her 500 frame'de
#     bir RMS istatistiği log'a düşer:
#       [tel_xxx] NoiseGate: 500fr | avg=187 max=12340 high=24% | thresh=0
#   Aşama 2 — Gate'i aktif et: log'daki `avg`'ın ~1.5x üstünü threshold yap.
#     Tipik telefon line noise: 100-250 → threshold 300-450 arası seç.
#     Şüpheliysen düşük tut (kesinti riski azalır, az gürültü sızar).
#
# Pre-roll (60ms): gate açılır açılmaz, gate kapalıyken yakalanmış son 3 frame
#   önce gönderilir → konuşmanın ilk hecesi kayıpsız geçer.
# Trailing (300ms): gate açıldıktan sonra RMS düşse de 15 frame daha açık kalır
#   → cümle sonu kesilmez.
PHONE_NOISE_GATE_RMS=0
PHONE_NOISE_GATE_TRAILING_MS=300
PHONE_NOISE_GATE_PREROLL_MS=60
# Gemini ses paketlerindeki kısa ağ dalgalanmalarını telefon tarafında yumuşatır.
# 200–4000 ms aralığı desteklenir; varsayılan 1200 ms.
PHONE_OUTPUT_BUFFER_MS=1200

# Netgsm SIP Trunk bilgileri
# (Online İşlemler > Ses Hizmeti > Ayarlar > SIP Bilgileri > Detay > Şifreyi Göster)
NETGSM_SIP_HOST=sip.netgsm.com.tr
NETGSM_SIP_PORT=5060
NETGSM_SIP_TRANSPORT=tcp
# Numaranız (başında 0 ya da +90 olmadan; örn 3121234567)
NETGSM_SIP_USER=
NETGSM_SIP_PASSWORD=
# Sunucu public IP'si (SDP'de yayınlanır, NAT geçişi için zorunlu)
NETGSM_PUBLIC_IP=80.225.236.202
# Asterisk → server köprüsü için RTP port aralığı (compose ile uyumlu olmalı)
RTP_START=10000
RTP_END=10200

# Netgsm HTTP API (SMS/OTP — opsiyonel)
# IP whitelist: https://www.netgsm.com.tr panelinden 80.225.236.202 zaten ekli.
NETGSM_API_BASE=https://api.netgsm.com.tr
NETGSM_API_USERCODE=
NETGSM_API_PASSWORD=
NETGSM_API_MSGHEADER=
