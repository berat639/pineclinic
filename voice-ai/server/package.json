{
  "name": "@voice-ai/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file ../.env src/index.ts",
    "start": "bun --env-file ../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/scripts/migrate-seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@google/genai": "^1.0.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.41.0",
    "elysia": "^1.4.28",
    "ioredis": "^5.0.0",
    "postgres": "^3.0.0",
    "redlock": "^4.2.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.30.0"
  }
}
