{
  "name": "@voice-ai/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun --env-file=../.env src/scripts/migrate-seed.ts",
    "db:seed-dental": "bun --env-file=../.env src/scripts/seed-dental.ts",
    "db:seed-users": "bun --env-file=../.env src/scripts/seed-users.ts",
    "db:import-json": "bun --env-file=../.env src/scripts/migrate-from-json.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.10",
    "@google/genai": "^1.0.0",
    "@ricky0123/vad-node": "^0.0.3",
    "@types/nodemailer": "^8.0.1",
    "bullmq": "^5.76.8",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "ioredis": "^5.10.1",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "^1.27.0",
    "postgres": "^3.4.9",
    "redlock": "^5.0.0-beta.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.30.0"
  }
}
